{"nodes": [{"id": "technical_docs_engineering", "label": "ENGINEERING.md (Chopper Engineering Doc)", "file_type": "document", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "technical_docs_engineering_doc", "label": "ENGINEERING.md (Engineering Plan)", "file_type": "document", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "technical_docs_engineering_hexagonal_pipeline", "label": "Hexagonal (ports-and-adapters) + Pipeline architectural style", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserves the architecture doc's 8-phase contract and determinism guarantees; aligns 1:1 with the Stage 0-5 build model; cross-module data flow is typed frozen dataclasses so services cannot corrupt each other's state."}, {"id": "technical_docs_engineering_flat_monolith_rejected", "label": "Flat monolith (rejected alternative)", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships fast but couples phases and kills isolated feature work."}, {"id": "technical_docs_engineering_microservices_rejected", "label": "Networked microservices (rejected alternative)", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires IPC, serialization, and process lifecycle management for zero business benefit on a <1 GB, 5-minute local run."}, {"id": "technical_docs_engineering_event_bus_rejected", "label": "Event-driven bus (rejected alternative)", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eventual consistency inside a deterministic pipeline is a contradiction."}, {"id": "technical_docs_engineering_serverless_rejected", "label": "Serverless / lambda (rejected alternative)", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anti-fit for filesystem-heavy workloads on VLSI checkouts."}, {"id": "technical_docs_engineering_service_catalog", "label": "Service catalog: one class, one public run() method per phase", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Services are stateless between invocations and never call each other, which is what makes isolated feature development possible."}, {"id": "technical_docs_engineering_dependency_rule", "label": "Strict layering rule: cli -> orchestrator -> services -> core; adapters -> core", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced at CI via import-linter; circular, inter-service, and reverse imports are rejected."}, {"id": "technical_docs_engineering_ports_protocol_design", "label": "Ports as typing.Protocol (structural typing), not ABCs", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural typing lets test fakes satisfy a port without importing Chopper internals or inheriting anything."}, {"id": "technical_docs_engineering_minimal_port_set", "label": "Minimal port set: only FileSystemPort, DiagnosticSink, ProgressSink", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No ClockPort, SerializerPort, AuditStore, or TableRenderer port; port abstractions for single-implementation concerns add ceremony without testability benefit."}, {"id": "technical_docs_engineering_no_lockport", "label": "No LockPort / no concurrency guard", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chopper is single-user, single-process, single-invocation; two racing operators is an operator-level mistake, not an architectural concern -- the second invocation aborts via normal validation error."}, {"id": "technical_docs_engineering_chopper_context", "label": "ChopperContext: port bundle + RunConfig (not a pure immutable record)", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "frozen=True guarantees port bindings cannot be rebound mid-run, but the ports themselves remain effectful."}, {"id": "technical_docs_engineering_config_split", "label": "RunConfig (engine behavior) vs PresentationConfig (CLI UX) split", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps CLI-only flags (verbose/quiet/plain) out of the service layer; services read only ctx.config (RunConfig)."}, {"id": "technical_docs_engineering_runner_phase_sequencing", "label": "ChopperRunner.run(): single hand-wired phase sequence, no plugin registry", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 has seven phases, period; adding a phase means editing runner.py directly, not registering a dynamic phase."}, {"id": "technical_docs_engineering_phase_gate_policy", "label": "Phase-gate policy: P1/P2/P3/P5/P6 gate on ERROR; P0/P4/P7 never gate", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each gated phase would otherwise let corrupted state (bad config, bad parse, contradictory manifest, broken trim) reach a later phase."}, {"id": "technical_docs_engineering_rollback_model", "label": "Rollback model: no staging tree, no atomic promotion", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On P5 failure, <domain>/ is left half-rebuilt and <domain>_backup/ untouched; the next invocation rebuilds from backup -- simplicity over transactional guarantees."}, {"id": "technical_docs_engineering_no_extension_seams", "label": "No general extension seams (Sec.7): no plugin host, observer fan-out, MCP, or AI advisor", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absence of reservations, not a list of them, is required -- a reservation reads as a TODO to a later contributor and drifts into an unapproved implementation."}, {"id": "technical_docs_engineering_diagnostic_contract", "label": "Diagnostic Emitter/Collector contract: single user-facing communication spine", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No print, no user-facing raise permitted in services; ctx.diag.emit(...) is the only channel for user-visible outcomes."}, {"id": "technical_docs_engineering_dedupe_last_write_wins", "label": "Diagnostic dedupe key (code, path, line_no, message, dedupe_bucket) with last-write-wins", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a later emit refine the hint/context of a previously emitted diagnostic without producing a duplicate entry; hint and context are excluded from the key."}, {"id": "technical_docs_engineering_strict_exit_code_policy", "label": "--strict is an exit-code policy only, never a severity rewrite", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A WARNING stays a WARNING in the sink, diagnostics.json, and rendered output regardless of --strict; the stored severity is the truth, --strict is only a policy layer on top."}, {"id": "technical_docs_engineering_exit_code_scheme", "label": "Exit code scheme: 0 clean, 1 error/strict-warning, 2 pre-pipeline fatal, 3 unhandled exception", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exit 3 is deliberately distinct from exit 1 so CI can tell 'pipeline found a problem' from 'Chopper itself broke'."}, {"id": "technical_docs_engineering_collectingsink_single_threaded", "label": "CollectingSink: not thread-safe by design, no future-concurrency promise", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 and every planned future version run single-threaded, so the sink never needs a lock and never will; parallelism would be a brand-new design discussion."}, {"id": "technical_docs_engineering_inter_service_no_imports", "label": "Inter-service communication rule: services never call each other, only return typed results", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced at CI by import-linter; the orchestrator alone wires results between services, so any service can be rewritten without touching siblings."}, {"id": "technical_docs_engineering_validator_parser_exception", "label": "Permitted exception: P6 validate_post imports P2 parser for post-trim re-verification", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-parsing trimmed Tcl output is the cleanest way to verify the TrimReport's proc-set promise (VW-10); the parser does not import the validator, so no bidirectional coupling is introduced."}, {"id": "technical_docs_engineering_feature_isolation_rules", "label": "Feature work isolation rules: one service = one module = one stage gate", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes every feature individually and isolatedly developable; stage discipline (stage N cannot import stage N+1) is enforced by import-linter CI contracts."}, {"id": "technical_docs_engineering_test_context_helper", "label": "make_test_context(): single shared factory for stateless test setup", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every test builds a fresh ChopperContext with stub adapters (InMemoryFS, CollectingSink, SilentProgress); no module-level contexts or shared sinks, so state cannot leak across tests."}, {"id": "technical_docs_engineering_single_threaded_determinism", "label": "Single-threaded execution as a closed design decision (no thread pools, asyncio, multiprocessing, or locks)", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Determinism requires sorted iteration over user data plus fixed phase order plus single-threaded execution together guaranteeing reproducible output; a racing second operator is an accepted failure mode, not a bug to guard against."}, {"id": "technical_docs_engineering_r1_ordered_overlay", "label": "R1 ordered-overlay merge: base then features left-to-right, last layer mentioning a file/proc wins", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced the additive-only two-pass per-source classification + cross-source aggregation model retired in 2.0.0-alpha; conflicting transitions emit VW-21 layer-shadowed with provenance instead of silently aggregating."}, {"id": "technical_docs_engineering_q1_no_plugin_mcp_advisor", "label": "Closed decision Q1: no plugin host, AI advisor, or MCP surface of any kind", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserving open-ended extension points invites drift (a reservation reads as a TODO and gets filled in); the narrow read-only stdio MCP server shipped in 0.4.0 carried ongoing dependency/maintenance cost for an unused surface and was removed in 4.0.0."}, {"id": "technical_docs_engineering_q2_no_hand_edit_preservation", "label": "Closed decision Q2: no hand-edit preservation on re-trim", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single source of truth is <domain>_backup/ plus the JSON selection; an automatic stash would encourage operators to rely on it as a versioning system, which it is not."}, {"id": "technical_docs_engineering_q3_no_locking", "label": "Closed decision Q3: no concurrency/locking mechanism", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real hazard (two concurrent writers on one disk) is an operator-level contract violation no cooperative file lock can fully prevent; removing locks eliminates stale-lock, crash-recovery, and cross-platform fcntl/msvcrt complexity."}, {"id": "technical_docs_engineering_q6_utf8_latin1_fallback", "label": "Closed decision Q6: UTF-8 read with Latin-1 fallback on decode failure (PW-02)", "file_type": "concept", "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Determinism requires a fixed fallback encoding; Latin-1 is chosen because every byte sequence decodes without error."}], "edges": [{"source": "technical_docs_engineering_doc", "target": "technical_docs_architecture_doc", "relation": "subordinate_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_hexagonal_pipeline", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_service_catalog", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_chopper_context", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_diagnostic_contract", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_inter_service_no_imports", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_feature_isolation_rules", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_single_threaded_determinism", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_no_extension_seams", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_r1_ordered_overlay", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_q1_no_plugin_mcp_advisor", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_q2_no_hand_edit_preservation", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_q3_no_locking", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_doc", "target": "technical_docs_engineering_q6_utf8_latin1_fallback", "relation": "documents", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_hexagonal_pipeline", "target": "technical_docs_engineering_flat_monolith_rejected", "relation": "rejects_alternative", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_hexagonal_pipeline", "target": "technical_docs_engineering_microservices_rejected", "relation": "rejects_alternative", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "technical_docs/ENGINEERING.md", "source_location": null, "weight": 1.0}, {"source": "technical_docs_engineering_hexagonal_pipeline", "target": "technical_docs_engineering_event_bus_rejected", "relation": "rejects_alternative", "confide