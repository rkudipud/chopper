l_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "technical_docs_implementation_double_quote_rule", "label": "Double Quotes (Tcl Endekas/Dodekalogue Rule 5)", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unescaped quote at a word boundary (SOF/whitespace/;/[) opens a quoted word at any brace depth; braces/semicolons/newlines inside are literal until the matching unescaped quote closes."}, {"id": "technical_docs_implementation_proc_detection_context_stack", "label": "Proc Detection Context Stack", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves TC-01: procs are recognized only when context-stack top is FILE_ROOT or NAMESPACE_EVAL, never inside CONTROL_FLOW or PROC_BODY."}, {"id": "technical_docs_implementation_dpa_detection", "label": "define_proc_attributes (DPA) Detection", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synopsys DPA metadata blocks must be dropped/kept atomically with their associated proc; name is the first whitespace token after the keyword regardless of option-list shape."}, {"id": "technical_docs_implementation_call_extraction_algorithm", "label": "Call Extraction Algorithm", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hybrid token-stream + regex filter: classification regex runs on tokenizer-produced token values only, never on raw file text."}, {"id": "technical_docs_implementation_suppression_cascade", "label": "SNORT-Derived Suppression Cascade", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapted from SNORT's production-proven _IsProcFoundInLine() 4-level cascade (15+ years on Intel EDA codebases) to suppress log-string mentions, option-flag args, and vendor commands."}, {"id": "technical_docs_implementation_procentry_model", "label": "ProcEntry Output Model", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "technical_docs_implementation_canonical_name_resolution", "label": "Canonical Name & Call Resolution Contract", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves TC-02: canonical form is file.tcl::qualified_name; absolute (::) tokens override active namespace; ambiguous/unresolved calls emit TW-01/TW-02."}, {"id": "technical_docs_implementation_p01_quote_in_braced_body", "label": "P-01: Quote Context Inside Braced Proc Body", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production bug: a stray brace inside a string literal inside a braced body desynced proc boundaries; fixed by treating brace-delimited bodies as re-parsed Tcl where Rule 5 applies at any depth."}, {"id": "technical_docs_implementation_p02_backslash_continuation", "label": "P-02: Backslash Line Continuation Corrupts Line Numbers", "file_type": "concept", "source_file": "technical_docs/IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "c